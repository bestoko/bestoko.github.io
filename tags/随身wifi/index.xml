height="1206"
srcset="https://bestoko.cc/p/scr01/SCR01_Setting2_hu_7df02e6527d6c2b3.png 480w, https://bestoko.cc/p/scr01/SCR01_Setting2_hu_58f32c74520b37f1.png 1024w"
loading="lazy"
class="gallery-image"
data-flex-grow="48"
